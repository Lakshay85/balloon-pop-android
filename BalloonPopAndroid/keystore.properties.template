# Copy this file to "keystore.properties" (same folder) and fill in the values
# from the keystore you used to sign the v1.0 release. keystore.properties is
# gitignored on purpose. Never commit it or send it to anyone.
storeFile=/absolute/path/to/your-upload-key.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
